{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@aegisvolt/common": ["./packages/common/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "graphql-gateway/src/**/*.ts",
    "graphql-gateway/test/**/*.ts",
    "graphql-gateway/scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
